    def connect(self, host, port, login, password, use_https, timeout=60, token=None):
        protocol = 'https' if use_https else 'http'
        self._connection_target.host = host
        self._connection_target.port = port
        self._connection_target.login = login
        self._connection_target.password = password
        self._connection_target.protocol = protocol
        if token:
            # token = f'{{accessToken:{token}}}'
            token = {'access_token': token}
            token = CmdLineJsonReader.json_to_str(token)
            connection_cmd = f'connectSso -host {host} -port {port} -protocol {protocol} -token {token} -debug'
        else:
            connection_cmd = 'connect -host %s -port %s -login %s -password "%s" -protocol %s -debug'
            connection_cmd %= (host, port, login, password, protocol)
        connect_done = False
        start_time = time.time()
        while time.time() - start_time < timeout:
            try:
                result = self.execute(connection_cmd)
                print("connected. time : ", time.ctime())
                request = CmdLineJsonReader.get_json_request('getServerInfo', result)
                print("execute function getServerInfo. time : ", time.ctime())
                self._session_id = request['session_id']
                connect_done = True
                break
            except CmdLineException as ex:
                error = ex.get_error()
                assert error != 'Operation failed', 'authentication error {%s/%s}' % (login, password)
                assert error != 'Error', 'network access error {%s://%s:%s}' % (protocol, host, port)
                assert error == 'Server is not available', 'unknown error ---> %s <---' % error
                print(str(error), "time of err: ", time.ctime())
                time.sleep(1)
        else:
            print("Start time = %s Session id = %s" % (str(start_time), self._session_id))
            print("TIMEOUT, connect_done: ", connect_done)
            print("Time now - ", time.ctime())
